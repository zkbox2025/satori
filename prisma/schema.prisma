generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                    String                 @id
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  name                  String?
  email                 String                 @unique
  avatarUrl             String?
  bio                   String?
  works                 Work[]
  feedback              Feedback[]
  generatedContents     GeneratedContent[]
  workLikes             WorkLike[]
  generatedContentLikes GeneratedContentLike[]
  aiRateLimitEvents AiRateLimitEvent[] 
}

model Work {
  id         String     @id @default(uuid())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  title      String
  content    String
  genre      String // slug形式 (例: "mental-health")
  visibility Visibility @default(PRIVATE)
  status     Status     @default(DRAFT)
  userId     String
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  feedback          Feedback?
  generatedContents GeneratedContent[]
  likes             WorkLike[]

  @@index([userId])
  @@index([userId, status, visibility])
  @@index([status, visibility, createdAt])
}

model Feedback {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  content String @db.Text // SUCCESS時に本文。ERROR時は空文字でもOK運用

  workId String
  userId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  prompt            String?   @db.Text
  inputSnapshot     Json?
  resultJson        Json?
  modelName         String?
  status            AiStatus @default(PENDING)
  errorMessage      String?  @db.Text
  tokensInput       Int?
  tokensOutput      Int?
  costUsdMicro      Int?
  promptVersion     Int      @default(1)
  providerRequestId String?

  @@unique([workId])
  @@index([workId])
  @@index([status, updatedAt])
}

model GeneratedContent {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  title         String
  generatedText String @db.Text

  visibility Visibility   @default(PRIVATE)
  style      ContentStyle

  workId String
  userId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  likes GeneratedContentLike[]

  prompt            String?   @db.Text
  inputSnapshot     Json?
  resultJson        Json?
  modelName         String?
  status            AiStatus @default(PENDING)
  errorMessage      String?  @db.Text
  tokensInput       Int?
  tokensOutput      Int?
  costUsdMicro      Int?
  promptVersion     Int      @default(1)
  providerRequestId String?

  @@index([workId])
  @@index([userId])
  @@index([userId, visibility])
  @@index([visibility, createdAt])
  @@index([status, createdAt])
}

model WorkLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  workId String
  work   Work   @relation(fields: [workId], references: [id], onDelete: Cascade)

  @@unique([userId, workId])
  @@index([workId])
  @@index([userId])
}

model GeneratedContentLike {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  generatedContentId String
  generatedContent   GeneratedContent @relation(fields: [generatedContentId], references: [id], onDelete: Cascade)

  @@unique([userId, generatedContentId])
  @@index([generatedContentId])
  @@index([userId])
}

model AiRateLimitEvent {
  id        String   @id @default(cuid())
  userId    String
  action    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, action, createdAt])
}

enum ContentStyle {
  POEM
}

enum Visibility {
  PUBLIC
  PRIVATE
}

enum Status {
  DRAFT
  PUBLISHED
}

enum AiStatus {
  PENDING
  SUCCESS
  ERROR
}
